{
  "name": "electrofishing",
  "version": "2.4.13",
  "type": "module",
  "scripts": {
    "build:stage": "export VITE_BUILD=stage && pnpm run build:sw && vite build",
    "build:sw": "esbuild src/ServiceWorker.js --bundle --outfile=public/ServiceWorker.js --define:process.env.VITE_FIREBASE_CONFIG=$(npx dotenv -p VITE_FIREBASE_CONFIG)",
    "build": "export VITE_BUILD=prod && pnpm run build:sw && vite build",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:app": "pnpm run build:sw && vite",
    "start:e2e-resources": "concurrently 'firebase emulators:start --only firestore,auth' 'vite'",
    "start:e2e": "playwright test --ui",
    "start:firebase-emulators": "./scripts/start-emulators.sh",
    "start": "concurrently 'wait-on http://127.0.0.1:4000 && pnpm run start:app' 'pnpm run start:firebase-emulators'",
    "storybook": "storybook dev -p 9009",
    "test": "pnpm run lint && vitest"
  },
  "browserslist": [
    "last 2 versions and > 2%"
  ],
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "bootstrap": "4.6.2",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "downshift": "^9.0.10",
    "esri-leaflet": "^3.0.19",
    "firebase": "^12.8.0",
    "immer": "^10.2.0",
    "jquery": "^3.6.4",
    "ky": "^1.14.0",
    "leaflet": "^1.9.4",
    "leaflet-loading": "^0.1.24",
    "localforage": "^1.10.0",
    "lodash": "^4.17.23",
    "papaparse": "^5.5.3",
    "popper.js": "^1.16.1",
    "proj4": "^2.20.2",
    "proj4leaflet": "^1.0.2",
    "prop-types": "^15.8.1",
    "pubsub-js": "^1.9.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.0",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.0.5",
    "spin.js": "^4.1.2",
    "use-immer": "^0.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-links": "^10.2.4",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react-vite": "^10.2.4",
    "@types/node": "^24.10.1",
    "@ugrc/eslint-config": "^1.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "firebase-tools": "^14.24.2",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "storybook": "^10.2.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  }
}
